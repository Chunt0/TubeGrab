#!/bin/sh
# Installed on the NAS as /volume1/git/tubegrab.git/hooks/post-receive (copy kept here).
# TubeGrab push-to-deploy: a push to `main` checks the code out into the
# Container Manager project, rebuilds the image and restarts the container.
REPO=/volume1/git/tubegrab.git
TARGET=/volume1/docker/tubegrab
DOCKER=/usr/local/bin/docker

while read -r old new ref; do
    [ "$ref" = "refs/heads/main" ] || { echo "[deploy] ignoring $ref (only main deploys)"; continue; }
    echo "[deploy] $(git --git-dir="$REPO" log -1 --format='%h %s' "$new")"
    git --git-dir="$REPO" --work-tree="$TARGET" checkout -f main || exit 1
    cd "$TARGET" || exit 1
    echo "[deploy] building image…"
    $DOCKER compose build --quiet || { echo "[deploy] BUILD FAILED — the running version was left as it was"; exit 1; }
    echo "[deploy] restarting…"
    $DOCKER compose up -d --remove-orphans 2>&1 | grep -v "^ *Container .* Running$"
    # ready = the app answers (Docker's own health check only runs every 30 s)
    i=0; ok=""
    while [ $i -lt 60 ]; do
        curl -fsS -m 3 -o /dev/null http://127.0.0.1:8765/api/jobs 2>/dev/null && { ok=1; break; }
        sleep 1; i=$((i + 1))
    done
    [ -n "$ok" ] && echo "[deploy] tubegrab is up (${i}s)" || { echo "[deploy] tubegrab did not come up — check: docker logs tubegrab"; exit 1; }
    $DOCKER image prune -f >/dev/null 2>&1   # drop the old image layers
done
